# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments & env files
venv/
.venv/
env/
.env

# Distribution / packaging
*.egg-info/
dist/
build/

# Uploaded & generated runtime files
uploads/*
!uploads/**/.gitkeep
!uploads/.gitkeep
scratch/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# Paddle / HuggingFace / Model caches
.paddlex/
.paddleocr/
.cache/
huggingface/
*.onnx
*.pt
*.pth
*.bin

# Temporary & system files
*.tmp
*.log
.DS_Store
Thumbs.db
