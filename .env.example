# ==============================================================================
# BorderShield — AI-Driven Document Screening & E-Gate Identity Verification System
# Environment Configuration Template (Smart India Hackathon 2026 - PS 26188)
# ==============================================================================
# Copy this file to .env and configure appropriately for your deployment environment.
# NEVER commit the actual .env file to source control.

# ------------------------------------------------------------------------------
# 1. Deployment Stage & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=false                            # Set to false in production

# ------------------------------------------------------------------------------
# 2. CORS & Network Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins or JSON array.
# Wildcard (*) is strictly forbidden in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Cryptographic Keys (Required in Production — Fail Closed)
# ------------------------------------------------------------------------------
# Generate 256-bit keys using:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# Base64-encoded 32-byte master key for AES-256-GCM PII & biometric vault encryption
ENCRYPTION_MASTER_KEY=

# Base64-encoded 32-byte secret key for HMAC-SHA-256 identifier tokenization
HMAC_SECRET_KEY=

# Master application secret key
SECRET_KEY=

# Ed25519 private key (hex or base64) for signing canonical audit events
ED25519_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Database Configuration
# ------------------------------------------------------------------------------
# Leave empty to use default local SQLite databases (offline hackathon demo).
# For production PostgreSQL: postgresql://username:password@hostname:5432/bordershield
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. Ephemeral Storage & Retention (DPDP Act 2023 Compliance)
# ------------------------------------------------------------------------------
DOCUMENT_RETENTION_HOURS=24            # Ephemeral upload lifetime in hours
BIOMETRIC_RETENTION_HOURS=72           # Biometric vector retention in hours
FORENSIC_ARTIFACT_RETENTION_HOURS=24   # ELA heatmaps and overlays retention in hours
MAX_UPLOAD_SIZE_BYTES=15728640         # 15 MB max file upload size

# ------------------------------------------------------------------------------
# 6. Audit Ledger & National Blockchain Framework (NBF / Vishvasya)
# ------------------------------------------------------------------------------
# Options: LOCAL_LEDGER (cryptographic SQLite chain) or NBF_PERMISSIONED (NBF adapter)
LEDGER_MODE=LOCAL_LEDGER

# Sovereign NBF / Vishvasya node endpoint (when deployed in government sandbox)
NBF_ENDPOINT=

# Station and officer credentials for checkpoint session context
DEFAULT_OFFICER_ID=SSB-OFFICER-7429
DEFAULT_OFFICER_ROLE=SCREENING_OFFICER

# ------------------------------------------------------------------------------
# 7. Auditable Model Version Tags
# ------------------------------------------------------------------------------
OCR_MODEL_VERSION=PaddleOCR_v6_TrOCR_Fallback_v1.0
FACE_MODEL_VERSION=MobileNetV3_L2_576d_v1.0
TAMPERING_MODEL_VERSION=ViT_Forensics_ELA_Stamp_v1.0
